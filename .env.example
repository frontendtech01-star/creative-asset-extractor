# Google Sheet feedback inbox (recommended)
# Spreadsheet: https://docs.google.com/spreadsheets/d/1dxhHtdi06oOwh-9d-ZdMxo8Wa7LIYJBu7lWXTsaP2xI/edit
# 1. Open the sheet → Extensions → Apps Script
# 2. Paste scripts/google-sheets-feedback.gs and save
# 3. Deploy → New deployment → Web app (Execute as: Me, Access: Anyone)
# 4. Paste the Web app URL below
GOOGLE_SHEET_ID=1dxhHtdi06oOwh-9d-ZdMxo8Wa7LIYJBu7lWXTsaP2xI
GOOGLE_SHEET_FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional packaged-app config: ~/.creative-asset-extractor/feedback-config.json
# {
#   "sheetId": "1dxhHtdi06oOwh-9d-ZdMxo8Wa7LIYJBu7lWXTsaP2xI",
#   "sheetWebhookUrl": "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
# }

# Google Form fallback (public POST endpoint — no API secrets)
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/FORM_ID/formResponse
GOOGLE_FORM_NAME_ENTRY=entry.XXXXXXXX
GOOGLE_FORM_SUGGESTIONS_ENTRY=entry.YYYYYYYY

# Optional Vite aliases (same values as above if you prefer VITE_ prefix)
VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/FORM_ID/formResponse
VITE_GOOGLE_FORM_NAME_ENTRY=entry.XXXXXXXX
VITE_GOOGLE_FORM_SUGGESTIONS_ENTRY=entry.YYYYYYYY

# GitHub release check (public API — no token in app)
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=creative-asset-extractor

# Optional server-side override (used by /api/github-latest-release in packaged app)
GITHUB_OWNER=your-github-username
GITHUB_REPO=creative-asset-extractor
