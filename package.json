{
  "name": "creative-asset-extractor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "tsx server.ts",
    "start": "node scripts/start.mjs",
    "localhost": "node scripts/start-localhost.mjs",
    "package:localhost": "npm run build && node scripts/build-portable-localhost.mjs",
    "build": "vite build",
    "build:server": "tsc --noEmit",
    "build:desktop:server": "node scripts/build-server-bundle.mjs",
    "build:desktop": "node scripts/build-dmg.mjs",
    "dist:win": "node scripts/build-windows.mjs",
    "exe": "npm run dist:win",
    "dist:mac": "node scripts/build-dmg.mjs",
    "dmg": "node scripts/build-dmg.mjs",
    "qc:dmg": "node scripts/qc-dmg.mjs",
    "smoke:webp": "node scripts/smoke-webp-conversion.mjs",
    "smoke:teneo-svg": "node scripts/smoke-teneo-svg.mjs",
    "smoke:teneo-fonts": "node scripts/smoke-teneo-fonts.mjs",
    "smoke:rxsight-typekit": "node scripts/smoke-rxsight-typekit-fonts.mjs",
    "smoke:bissell": "node scripts/smoke-bissell-extraction.mjs",
    "smoke:warehouse-stationery": "node scripts/smoke-warehouse-stationery.mjs",
    "smoke:alprolix-icons": "node scripts/smoke-alprolix-icons.mjs",
    "smoke:reported-sites": "node scripts/smoke-reported-sites.mjs",
    "smoke:video-downloader": "node scripts/smoke-video-downloader.mjs",
    "smoke:feedback": "tsx scripts/smoke-feedback-regressions.mjs",
    "dist:linux": "npm run build && npm run build:desktop:server && electron-builder --linux AppImage",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview --host 0.0.0.0",
    "serve:static": "vite preview --host 0.0.0.0",
    "serve:light": "npm run start",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "setup:feedback": "node scripts/setup-google-feedback.mjs",
    "sync:ftp": "bash scripts/sync-ftp.sh",
    "size": "du -sh dist node_modules 2>/dev/null || true"
  },
  "build": {
    "appId": "com.creativeassetextractor.desktop",
    "productName": "Creative Asset Extractor",
    "directories": {
      "output": "release"
    },
    "beforePack": "scripts/electron-before-pack.cjs",
    "afterPack": "scripts/electron-after-pack.cjs",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "electron/**/*",
      "scripts/insights-page-evaluate.cjs",
      "server/**/*",
      "server.ts",
      "src/lib/streamUrl.ts",
      "package.json",
      "node_modules/archiver/**/*",
      "node_modules/archiver-utils/**/*",
      "node_modules/zip-stream/**/*",
      "node_modules/compress-commons/**/*",
      "node_modules/crc32-stream/**/*",
      "node_modules/async/**/*",
      "node_modules/lazystream/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/readdir-glob/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/fonteditor-core/**/*",
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*",
      "node_modules/@puppeteer/**/*",
      "node_modules/chromium-bidi/**/*",
      "node_modules/cosmiconfig/**/*",
      "node_modules/devtools-protocol/**/*",
      "node_modules/typed-query-selector/**/*",
      "node_modules/webdriver-bidi-protocol/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/ws/**/*",
      "node_modules/extract-zip/**/*",
      "node_modules/progress/**/*",
      "node_modules/proxy-agent/**/*",
      "node_modules/tar-fs/**/*",
      "node_modules/yargs/**/*",
      "node_modules/semver/**/*",
      "node_modules/get-stream/**/*",
      "node_modules/yauzl/**/*",
      "node_modules/fd-slicer/**/*",
      "node_modules/pend/**/*",
      "node_modules/agent-base/**/*",
      "node_modules/http-proxy-agent/**/*",
      "node_modules/https-proxy-agent/**/*",
      "node_modules/socks-proxy-agent/**/*",
      "node_modules/pac-proxy-agent/**/*",
      "node_modules/pac-resolver/**/*",
      "node_modules/lru-cache/**/*",
      "node_modules/degenerator/**/*",
      "node_modules/netmask/**/*",
      "node_modules/ast-types/**/*",
      "node_modules/escodegen/**/*",
      "node_modules/esprima/**/*",
      "node_modules/estraverse/**/*",
      "node_modules/esutils/**/*",
      "node_modules/smart-buffer/**/*",
      "node_modules/socks/**/*",
      "node_modules/b4a/**/*",
      "node_modules/events-universal/**/*",
      "node_modules/fast-fifo/**/*",
      "node_modules/streamx/**/*",
      "node_modules/tar-stream/**/*",
      "node_modules/y18n/**/*",
      "node_modules/cliui/**/*",
      "node_modules/escalade/**/*",
      "node_modules/get-caller-file/**/*",
      "node_modules/require-directory/**/*",
      "node_modules/string-width/**/*",
      "node_modules/yargs-parser/**/*",
      "node_modules/wrap-ansi/**/*",
      "node_modules/emoji-regex/**/*",
      "node_modules/is-fullwidth-code-point/**/*",
      "node_modules/strip-ansi/**/*",
      "node_modules/ansi-regex/**/*",
      "node_modules/env-paths/**/*",
      "node_modules/import-fresh/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/parse-json/**/*",
      "node_modules/path-type/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/youtube-dl-exec/bin/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "vendor/chromium-pack",
        "to": "chromium",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/bin-pack",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Creative.Asset.Extractor-Setup-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "dmg": {
      "format": "UDZO",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "minimumSystemVersion": "10.15",
      "mergeASARs": true,
      "x64ArchFiles": "**/chromium/**"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tanstack/react-virtual": "^3.14.2",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "axios": "^1.13.6",
    "basic-ftp": "^6.0.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fonteditor-core": "^2.6.3",
    "opentype.js": "^2.0.0",
    "puppeteer": "^24.38.0",
    "sharp": "^0.34.5",
    "srcset": "^5.0.3",
    "tsx": "^4.21.0",
    "ws": "^8.21.0",
    "youtube-dl-exec": "^3.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.3",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
